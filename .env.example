# Primary archive-capable RPC. The service has no signing key and never writes to chain.
PRIMARY_RPC_URL=https://YOUR_PRIMARY_ARCHIVE_RPC
# Must be an operationally independent provider for reserve verification.
SECONDARY_RPC_URL=https://YOUR_SECONDARY_ARCHIVE_RPC
CHAIN_ID=11155111
COLLATERAL_VAULT_ADDRESS=0x44345dFCD97973329A88aaE8c1432ea90525Ed13
# Block at or before the vault's first client-balance event.
DEPLOYMENT_BLOCK=0

# Every accepted collateral token must be listed explicitly.
TOKENS_JSON=[{"address":"0x947Cc17D8CbC0Fc1E64de138eE4947d3AF9C26EE","symbol":"mUSDC","decimals":6}]

# Reported separately and never netted against client liabilities.
RELATED_ACCOUNTS_JSON=[{"label":"Insurance Fund","address":"0x132Ba3d3073FDa7440fb0594210C47eC19087eaD"},{"label":"Fee Router","address":"0xBCEA366b30eb1dcAC6968AECcc215E8797553a5e"},{"label":"Treasury","address":"0xCc624fFA5df1F3F4b30aa8abd30186a86254F406"}]

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Hourly control and finalized-chain settings.
RECONCILIATION_INTERVAL_MS=3600000
BLOCK_CONFIRMATIONS=12
EVENT_CHUNK_SIZE=2000
RPC_READ_CONCURRENCY=20
WORKER_LEASE_SECONDS=120
DAILY_REVIEW_DUE_HOUR_UTC=10
LOG_LEVEL=info
PORT=8080

# Protects POST /runs for authorised ad-hoc reconciliations.
MANUAL_RUN_TOKEN=GENERATE_A_LONG_RANDOM_VALUE

# Optional alert delivery. A deficit is also routed to the urgent webhook.
ALERT_WEBHOOK_URL=
URGENT_WEBHOOK_URL=
WORKER_INSTANCE_ID=
